generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  category  String
  excerpt   String
  image     String
  body      String // JSON array of {type: 'h2'|'p'|'ul', ...} blocks
  published Boolean  @default(true)
  starred   Boolean  @default(false) // queued for the next newsletter
  /// Content pillar id (src/lib/pillars.ts) — the brand message this post carries
  pillarId  String?
  newsletteredAt DateTime? // set when a newsletter featuring this post went out
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoKit {
  id        Int      @id @default(autoincrement())
  postId    Int      @unique
  content   String // JSON of generated promo content (instagram/facebook/x/email)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        Int      @id @default(autoincrement())
  src       String
  caption   String   @default("")
  width     Int
  height    Int
  position  Int // 1 = first in the grid
  createdAt DateTime @default(now())
}

model Signup {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  source    String   @default("website")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  firstName String   @default("")
  lastName  String   @default("")
  email     String
  phone     String   @default("")
  service   String   @default("")
  message   String
  createdAt DateTime @default(now())
}

model MetaConnection {
  id             String    @id @default("default") // singleton row
  fbUserId       String?
  fbUserName     String?
  fbUserToken    String? // long-lived user access token
  pageId         String?
  pageName       String?
  pageToken      String? // long-lived Page access token (used to publish)
  igUserId       String? // linked Instagram Business account id, when present
  igUsername     String?
  adAccountId    String? // e.g. "act_1788471615529613"
  scopes         String? // comma-separated granted permissions
  tokenExpiresAt DateTime?
  connectedAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

model BlogSettings {
  id        String   @id @default("default") // singleton row
  voice     String   @default("")
  audience  String   @default("")
  style     String   @default("")
  dos       String   @default("") // one guideline per line
  donts     String   @default("") // one guideline per line
  updatedAt DateTime @updatedAt
}

// ───────── CONTENT PILLARS ─────────
// /admin/essence; the brand messages blog posts carry. `id` is the slug
// stored on BlogPost.pillarId. Code defaults in src/lib/pillars.ts apply
// when the table is empty.
model Pillar {
  id        String   @id
  name      String
  /// One line: the brand message this pillar carries
  message   String
  /// Angle prompts — starting points for a title or a caption
  angles    String[] @default([])
  /// Default hashtags (Instagram mainly)
  hashtags  String[] @default([])
  /// Target share of the content mix, in percent
  target    Int?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// ───────── BRAND ESSENCE (singleton) ─────────
// id = "default". The Throughline "Essence": one line, purpose, promise,
// do / don't lists, three voice sliders and the tone brief. Generators read
// it through src/lib/brandContext.ts; without a row the code defaults in
// src/lib/pillars.ts apply, folding in any saved BlogSettings tone.
model BrandEssence {
  id           String   @id @default("default")
  line         String   @default("")
  purpose      String   @default("")
  promise      String   @default("")
  doList       String[] @default([])
  dontList     String[] @default([])
  /// 0 = serious … 100 = playful
  voicePlayful Int      @default(50)
  /// 0 = casual … 100 = formal
  voiceFormal  Int      @default(50)
  /// 0 = gentle … 100 = bold
  voiceBold    Int      @default(50)
  /// BlogTone JSON (voice / audience / style / dos / donts)
  tone         Json?
  updatedAt    DateTime @updatedAt
}

// ───────── GROWTH / SEARCH (migration 20261109120000_growth_search) ─────────

/// Growth → Search → Keywords. Phrases Beth wants to be found for. `priority`
/// (0–100) is our own judgement of value, not search volume; it sizes the
/// word cloud until Search Console or Keyword Planner is connected.
model Keyword {
  id          String   @id
  phrase      String   @unique
  /// "problem" | "service" | "question"
  kind        String   @default("service")
  priority    Int      @default(50)
  /// "idea" | "target" | "dropped"
  status      String   @default("idea")
  /// "seed" | "claude" | "manual"
  source      String   @default("manual")
  note        String?
  /// Landing page built for this keyword, if any (LandingPage.slug)
  landingSlug String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, priority])
}

/// Growth → Landing pages. Public at /for/[slug] only when published.
model LandingPage {
  slug            String   @id
  keyword         String
  title           String
  metaDescription String   @default("")
  h1              String
  intro           String   @default("")
  /// Markdown body (## subheads, paragraphs, - lists)
  body            String
  /// [{ q, a }]
  faq             Json?
  heroImage       String?
  heroAlt         String?
  /// Complete-page sections (eyebrow, value prop, benefits, steps, CTA).
  /// Null for text-only pages.
  sections        Json?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// First-party conversion log from the public site.
model ConversionEvent {
  id        String   @id @default(cuid())
  /// "contact_click" | "contact_submit" | "signup" | "call_click"
  kind      String
  path      String?
  source    String?
  campaign  String?
  gclid     String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Ad spend entered by hand until an ads API is connected.
model SpendEntry {
  id          String   @id @default(cuid())
  /// "google" | "meta"
  channel     String
  /// First day of the period this spend covers
  periodStart DateTime
  amountCents Int
  results     Int?
  note        String?
  createdAt   DateTime @default(now())

  @@index([channel, periodStart])
}

/// Small key/value settings for the Growth pages (budget caps, competitor
/// list, checklist ticks).
model StudioSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
